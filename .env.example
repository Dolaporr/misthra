# Local, simulated HYPE preview. No wallet key is needed to try it.
ERRAND_MODE=demo
HOST=127.0.0.1
PORT=4317
# Comma-separated list of extra origins allowed to call the API. The server always
# accepts its own host, so this only matters for other domains (e.g. misthra.com).
APP_ORIGIN=http://127.0.0.1:5173
DB_PATH=data/errand.sqlite

# Optional agent connector settings; keep agent keys out of browser code.
# ERRAND_SITE=http://127.0.0.1:4317
# ERRAND_WALLET=/absolute/path/to/errand-elysium/data/agent-wallet.json
# ERRAND_CONNECT=one-use-pairing-code-from-the-app

# Chain adapter: only set an address AFTER deploying this project's contract.
# Do not use an original Robinhood Errandboard address here.
# ESCROW_ADDRESS=
# Local web app chain mode currently blocks financial writes until event
# reconciliation is integrated. Setting an address does not enable payments.

# A built demo can be served locally in production mode explicitly:
# ALLOW_DEMO_PRODUCTION=1

# --- Terminal: live Elysium data (leave unset for the labelled simulated feed) ---
# All four are required for live mode. Take addresses only from official sources.
# ELYSIUM_WHYPE and ELYSIUM_UNISWAP_V3_FACTORY accept comma-separated lists: the first
# entry is what the terminal trades through; the rest are only indexed (e.g. a pad's own factory).
ELYSIUM_RPC_URL=
ELYSIUM_CHAIN_ID=
ELYSIUM_WHYPE=
ELYSIUM_UNISWAP_V3_FACTORY=
# Optional
ELYSIUM_EXPLORER_URL=
ELYSIUM_INDEXER_START_BLOCK=
ELYSIUM_CONFIRMATIONS=20
# JSON file: [{"id":"citadel","name":"Citadel","url":"…","contracts":["0x…"],"locksLiquidity":true}]
ELYSIUM_PADS_FILE=
# Comma-separated token addresses with a HyperCore spot market (reviewed by hand until Kinetiq's hooks ship)
ELYSIUM_HYPERCORE_LISTED=
# Set to 1 only once every address above is confirmed by Kinetiq/Uniswap; otherwise the UI warns.
ELYSIUM_NETWORK_VERIFIED=0
# Trading: quoter plus the deployed Misthra trade gateway (npm run deploy:contracts)
ELYSIUM_UNISWAP_V3_QUOTER=
ELYSIUM_UNISWAP_V3_SWAP_ROUTER=
# Montra (Uniswap v4) launches. Mainnet values are in docs/elysium-mainnet.md.
ELYSIUM_MONTRA_FACTORY=
ELYSIUM_MONTRA_HOOK=
ELYSIUM_UNISWAP_V4_POOL_MANAGER=
MISTHRA_TRADE_GATEWAY=
# Shown in previews; live quotes read the fee from the gateway itself. 75 = 0.75%, matching Agora on Elysium
MISTHRA_TRADE_FEE_BPS=75

# --- Launch: Misthra fee router deployment (after a reviewed deployment) ---
MISTHRA_ROUTER_FACTORY=
MISTHRA_ROUTER_SWAP_ADAPTER=
MISTHRA_ROUTER_SHARED_GUARD=
MISTHRA_ROUTER_FEE_RECIPIENT=

# --- Agora: second trade route for pads Misthra does not index (bonding curves, Uniswap v4, Ascend) ---
# Builder code earns 30% of Agora's fee in HYPE; claim it at agoradex.app/dashboard with the treasury wallet.
# Keep AGORA_ENABLED=0 until the amount fields in chain/agora.mjs are checked against
# https://api.agoradex.app/api/v1/openapi.json.
AGORA_ENABLED=0
AGORA_API_KEY=
AGORA_BUILDER_CODE=
# Only transactions to these contracts are ever handed to a wallet (AgoraRouter, swap executor).
AGORA_ALLOWED_TARGETS=
